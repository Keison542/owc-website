# Dockerfile.web
FROM node:20-alpine AS builder

WORKDIR /app

RUN npm install -g pnpm

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY lib/ lib/
COPY artifacts/ artifacts/

RUN pnpm install --frozen-lockfile --filter=@workspace/owc-website
RUN pnpm build --filter=@workspace/owc-website

FROM nginx:alpine

COPY --from=builder /app/artifacts/owc-website/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 5173

CMD ["nginx", "-g", "daemon off;"]